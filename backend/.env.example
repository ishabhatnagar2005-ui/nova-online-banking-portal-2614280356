# JDBC URL for an existing local demonstration database
DATABASE_URL=jdbc:postgresql://localhost:5432/nova
DB_USERNAME=nova
DB_PASSWORD=nova-local-only
# Supply a fresh 32-byte-or-longer secret in a private environment
JWT_SECRET=replace-this-local-only-signing-secret-32bytes
# Never enable fixtures where real data or public access exists
DEMO_MODE=true
DEMO_PASSWORD=demo-only
CORS_ORIGINS=http://localhost:4200
SERVER_PORT=8080
TOKEN_SECONDS=86400
IDLE_SECONDS=150
# Fixed UTC date for the historical demonstration transaction range
DEMO_DATE=2026-10-14
